# Music Diary Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ListenBrainz Configuration
LISTENBRAINZ_USERNAME=your_username_here

# Last.fm API Configuration (optional)
# Get your API key at: https://www.last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_api_key_here

# Output Directory (optional, defaults to ./parquet_export)
OUTPUT_DIR=./parquet_export
